        <item><widget class="QToolButton" name="btnCopy"><property name="text"><string>复制</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnRotate"><property name="text"><string>旋转</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDelete"><property name="text"><string>删除</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMirror"><property name="text"><string>镜像</string></property><property name="toolTip"><string>先选中对象，再点取镜像轴两点</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnScale"><property name="text"><string>缩放</string></property><property name="toolTip"><string>先选中对象，再点取基点并输入比例</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnEnterEdit"><property name="text"><string>进入编辑</string></property><property name="toolTip"><string>默认只读；确认降级风险后启用 2D 可编辑模型（EDIT）</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnChangeColor"><property name="text"><string>线条改色</string></property><property name="toolTip"><string>批量修改选中对象的线条颜色（撤销可用）；命令 CHCOLOR</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><spacer name="spacerEdit"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
