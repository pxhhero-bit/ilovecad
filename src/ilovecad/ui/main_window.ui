      </widget>
      <widget class="QWidget" name="tabEdit">
       <attribute name="title"><string>编辑</string></attribute>
       <layout class="QHBoxLayout" name="layoutEdit">
        <item><widget class="QToolButton" name="btnSelect"><property name="text"><string>选择</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnUndo"><property name="text"><string>撤销</string></property><property name="toolTip"><string>Ctrl+Z</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnRedo"><property name="text"><string>重做</string></property><property name="toolTip"><string>Ctrl+Y</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
