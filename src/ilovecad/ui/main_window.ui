        <item><widget class="QToolButton" name="btnMeasureAngle"><property name="text"><string>测夹角(三点)</string></property><property name="toolTip"><string>顶点 → 第一边点 → 第二边点，显示夹角与补角</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureAngleLines"><property name="text"><string>测夹角(两线)</string></property><property name="toolTip"><string>点取两条直线 / 多段线，自动求夹角</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureClear"><property name="text"><string>清除结果</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
