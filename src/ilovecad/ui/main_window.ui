        <item><widget class="QToolButton" name="btnDrawColor"><property name="text"><string>绘图颜色</string></property><property name="toolTip"><string>为新绘制的实体选择线条颜色（默认随层）；命令 COLOR</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
