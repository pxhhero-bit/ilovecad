     </widget>
    </item>
    <item>
     <widget class="QSplitter" name="mainSplitter">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>
      <property name="childrenCollapsible"><bool>false</bool></property>
      <widget class="QWidget" name="leftPanel">
       <layout class="QVBoxLayout" name="leftLayout">
        <item><widget class="QLabel" name="labelLayers"><property name="text"><string>图层</string></property><property name="styleSheet"><string notr="true">font-weight:bold;padding:3px;</string></property></widget></item>
        <item><widget class="QLineEdit" name="layerSearch"><property name="placeholderText"><string>搜索图层…</string></property></widget></item>
        <item><widget class="QTreeWidget" name="layerTree"><column><property name="text"><string>显示</string></property></column><column><property name="text"><string>图层名</string></property></column><column><property name="text"><string>颜色</string></property></column></widget></item>
        <item><layout class="QHBoxLayout" name="layerButtons"><item><widget class="QPushButton" name="btnLayerAllOn"><property name="text"><string>全部显示</string></property></widget></item><item><widget class="QPushButton" name="btnLayerInvert"><property name="text"><string>反选</string></property></widget></item></layout></item>
       </layout>
      </widget>
      <widget class="CadCanvas" name="canvas">
       <property name="minimumSize"><size><width>500</width><height>400</height></size></property>
       <property name="mouseTracking"><bool>true</bool></property>
       <property name="focusPolicy"><enum>Qt::StrongFocus</enum></property>
      </widget>
      <widget class="QWidget" name="rightPanel">
       <layout class="QVBoxLayout" name="rightLayout">
        <item><widget class="QLabel" name="labelProp"><property name="text"><string>属性</string></property><property name="styleSheet"><string notr="true">font-weight:bold;padding:3px;</string></property></widget></item>
        <item><widget class="QTreeWidget" name="propTree"><column><property name="text"><string>属性</string></property></column><column><property name="text"><string>值</string></property></column></widget></item>
        <item><widget class="QLabel" name="labelMeasure"><property name="text"><string>测量结果</string></property><property name="styleSheet"><string notr="true">font-weight:bold;padding:3px;</string></property></widget></item>
        <item><widget class="QListWidget" name="measureList"/></item>
        <item><widget class="QLabel" name="labelReport"><property name="text"><string>导入报告</string></property><property name="styleSheet"><string notr="true">font-weight:bold;padding:3px;</string></property></widget></item>
        <item><widget class="QTextBrowser" name="reportBrowser"><property name="maximumSize"><size><width>16777215</width><height>150</height></size></property></widget></item>
       </layout>
      </widget>
     </widget>
    </item>
    <item>
     <widget class="QFrame" name="commandBar">
      <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
      <property name="maximumSize"><size><width>16777215</width><height>42</height></size></property>
      <layout class="QHBoxLayout" name="commandLayout">
       <item><widget class="QLabel" name="commandTitle"><property name="text"><string>命令：</string></property><property name="styleSheet"><string notr="true">font-weight:bold;</string></property></widget></item>
       <item><widget class="QLabel" name="commandHint"><property name="text"><string>就绪。打开图纸开始看图；滚轮缩放，中键拖动平移。</string></property></widget></item>
       <item><spacer name="spacerCommand"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       <item><widget class="QLineEdit" name="commandInput"><property name="placeholderText"><string>输入命令（DI 测距 / L 直线 / C 圆 / E 删除 / Z 全图）</string></property><property name="maximumSize"><size><width>360</width><height>16777215</height></size></property></widget></item>
      </layout>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar">
   <property name="geometry"><rect><x>0</x><y>0</y><width>1440</width><height>26</height></rect></property>
   <widget class="QMenu" name="menuFile"><property name="title"><string>文件(&amp;F)</string></property><addaction name="actOpen"/><addaction name="actSave"/><addaction name="actSaveAs"/><addaction name="separator"/><addaction name="actExportPdf"/><addaction name="actExportDxf"/><addaction name="separator"/><addaction name="actQuit"/></widget>
   <widget class="QMenu" name="menuView"><property name="title"><string>视图(&amp;V)</string></property><addaction name="actFit"/><addaction name="actZoomIn"/><addaction name="actZoomOut"/><addaction name="separator"/><addaction name="actThemeSettings"/></widget>
   <widget class="QMenu" name="menuEdit"><property name="title"><string>编辑(&amp;E)</string></property><addaction name="actUndo"/><addaction name="actRedo"/><addaction name="actDelete"/></widget>
   <widget class="QMenu" name="menuMeasure"><property name="title"><string>测量(&amp;M)</string></property><addaction name="actMeasureDistance"/><addaction name="actMeasureArea"/><addaction name="actMeasureAngle"/><addaction name="actMeasureAngleLines"/></widget>
   <widget class="QMenu" name="menuHelp"><property name="title"><string>帮助(&amp;H)</string></property><addaction name="actAbout"/></widget>
   <addaction name="menuFile"/><addaction name="menuView"/><addaction name="menuEdit"/><addaction name="menuMeasure"/><addaction name="menuHelp"/>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
  <action name="actOpen"><property name="text"><string>打开图纸</string></property><property name="shortcut"><string>Ctrl+O</string></property></action>
  <action name="actSave"><property name="text"><string>保存 (R2004)</string></property><property name="shortcut"><string>Ctrl+S</string></property></action>
  <action name="actSaveAs"><property name="text"><string>另存为…</string></property><property name="shortcut"><string>Ctrl+Shift+S</string></property></action>
  <action name="actExportPdf"><property name="text"><string>导出 PDF</string></property><property name="shortcut"><string>Ctrl+P</string></property></action>
  <action name="actExportDxf"><property name="text"><string>导出 DXF</string></property></action>
  <action name="actQuit"><property name="text"><string>退出</string></property><property name="shortcut"><string>Ctrl+Q</string></property></action>
  <action name="actFit"><property name="text"><string>适应全图</string></property><property name="shortcut"><string>Z</string></property></action>
  <action name="actZoomIn"><property name="text"><string>放大</string></property></action>
  <action name="actZoomOut"><property name="text"><string>缩小</string></property></action>
  <action name="actUndo"><property name="text"><string>撤销</string></property><property name="shortcut"><string>Ctrl+Z</string></property></action>
  <action name="actRedo"><property name="text"><string>重做</string></property><property name="shortcut"><string>Ctrl+Y</string></property></action>
  <action name="actDelete"><property name="text"><string>删除</string></property><property name="shortcut"><string>Delete</string></property></action>
  <action name="actMeasureDistance"><property name="text"><string>测距离</string></property><property name="shortcut"><string>DI</string></property></action>
  <action name="actMeasureArea"><property name="text"><string>测面积</string></property></action>
  <action name="actMeasureAngle"><property name="text"><string>测夹角（三点）</string></property><property name="shortcut"><string>ANG</string></property></action>
  <action name="actMeasureAngleLines"><property name="text"><string>测夹角（两条线）</string></property></action>
  <action name="actThemeSettings"><property name="text"><string>界面主题设置…</string></property></action>
  <action name="actAbout"><property name="text"><string>关于 IloveCAD</string></property></action>
 </widget>
