        <item><widget class="QToolButton" name="btnCopy"><property name="text"><string>复制</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnRotate"><property name="text"><string>旋转</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDelete"><property name="text"><string>删除</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><spacer name="spacerEdit"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </widget>
      <widget class="QWidget" name="tabMeasure">
       <attribute name="title"><string>测量</string></attribute>
       <layout class="QHBoxLayout" name="layoutMeasure">
        <item><widget class="QToolButton" name="btnMeasureDistance"><property name="text"><string>测距离</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureChain"><property name="text"><string>累计长度</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureArea"><property name="text"><string>测面积</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureRadius"><property name="text"><string>半径 / 直径</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureAngle"><property name="text"><string>测夹角(三点)</string></property><property name="toolTip"><string>顶点 → 第一边点 → 第二边点，显示夹角与补角</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureAngleLines"><property name="text"><string>测夹角(两线)</string></property><property name="toolTip"><string>点取两条直线 / 多段线，自动求夹角</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnMeasureClear"><property name="text"><string>清除结果</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><spacer name="spacerMeasure"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </widget>
      <widget class="QWidget" name="tabOutput">
       <attribute name="title"><string>输出</string></attribute>
       <layout class="QHBoxLayout" name="layoutOutput">
        <item><widget class="QToolButton" name="btnExportPdf"><property name="text"><string>导出 PDF</string></property><property name="toolTip"><string>独立矢量渲染路径，不经过 DWG 写入</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnExportDxf"><property name="text"><string>导出 DXF</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><spacer name="spacerOutput"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
