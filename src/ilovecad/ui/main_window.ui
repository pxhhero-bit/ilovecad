<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1440</width><height>900</height></rect>
  </property>
  <property name="windowTitle">
   <string>IloveCAD — 2D 图纸查看与轻量编辑</string>
  </property>
  <!-- Colours deliberately live in src/ilovecad/theme.py so the dark / light
       setting can be switched at runtime. Layout-only properties stay here. -->
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">
    <property name="spacing"><number>2</number></property>
    <property name="leftMargin"><number>4</number></property>
    <property name="rightMargin"><number>4</number></property>
    <property name="topMargin"><number>4</number></property>
    <property name="bottomMargin"><number>2</number></property>
    <item>
     <widget class="QTabWidget" name="ribbonTabs">
      <property name="maximumSize"><size><width>16777215</width><height>106</height></size></property>
      <property name="tabPosition"><enum>QTabWidget::North</enum></property>
      <widget class="QWidget" name="tabFile">
       <attribute name="title"><string>文件</string></attribute>
       <layout class="QHBoxLayout" name="layoutFile">
        <item><widget class="QToolButton" name="btnOpen"><property name="text"><string>打开图纸</string></property><property name="toolTip"><string>打开 DWG / DXF (Ctrl+O)</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnSave"><property name="text"><string>保存</string></property><property name="toolTip"><string>保存为 R2004 (Ctrl+S)</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnSaveAs"><property name="text"><string>另存为</string></property><property name="toolTip"><string>始终输出 AC1018 / R2004</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnImportReport"><property name="text"><string>导入报告</string></property><property name="toolTip"><string>查看降版本与跳过对象明细</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnAbout"><property name="text"><string>关于</string></property><property name="toolTip"><string>版本与许可说明</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><spacer name="spacerFile"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </widget>
      <widget class="QWidget" name="tabView">
       <attribute name="title"><string>视图</string></attribute>
       <layout class="QHBoxLayout" name="layoutView">
        <item><widget class="QToolButton" name="btnFit"><property name="text"><string>适应全图</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnZoomIn"><property name="text"><string>放大</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnZoomOut"><property name="text"><string>缩小</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnZoomWindow"><property name="text"><string>窗口缩放</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnPan"><property name="text"><string>平移</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDark"><property name="text"><string>黑底 / 白底</string></property><property name="toolTip"><string>仅切换画布背景色；整体界面主题请在「主题设置」中修改</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnThemeSettings"><property name="text"><string>主题设置</string></property><property name="toolTip"><string>深色（默认） / 浅色界面主题，选择保存在本机</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><spacer name="spacerView"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </widget>
      <widget class="QWidget" name="tabDraw">
       <attribute name="title"><string>绘制</string></attribute>
       <layout class="QHBoxLayout" name="layoutDraw">
        <item><widget class="QToolButton" name="btnDrawLine"><property name="text"><string>直线</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDrawPolyline"><property name="text"><string>多段线</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDrawRect"><property name="text"><string>矩形</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDrawCircle"><property name="text"><string>圆</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDrawArc"><property name="text"><string>圆弧</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><widget class="QToolButton" name="btnDrawText"><property name="text"><string>文字</string></property><property name="minimumSize"><size><width>78</width><height>54</height></size></property></widget></item>
        <item><spacer name="spacerDraw"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
