<ui version="4.0">
 <class>PdfExportDialog</class>
 <widget class="QDialog" name="PdfExportDialog">
  <property name="windowTitle"><string>导出矢量 PDF</string></property>
  <property name="geometry"><rect><x>0</x><y>0</y><width>420</width><height>310</height></rect></property>
  <layout class="QVBoxLayout" name="vbox">
   <item>
    <widget class="QGroupBox" name="groupPage">
     <property name="title"><string>页面</string></property>
     <layout class="QFormLayout" name="formPage">
      <item row="0" column="0"><widget class="QLabel" name="labelPaper"><property name="text"><string>纸张</string></property></widget></item>
      <item row="0" column="1"><widget class="QComboBox" name="comboPaper"><item><property name="text"><string>A4</string></property></item><item><property name="text"><string>A3</string></property></item><item><property name="text"><string>A2</string></property></item></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="labelOrient"><property name="text"><string>方向</string></property></widget></item>
      <item row="1" column="1"><widget class="QComboBox" name="comboOrientation"><item><property name="text"><string>横向</string></property></item><item><property name="text"><string>纵向</string></property></item></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="labelScope"><property name="text"><string>范围</string></property></widget></item>
      <item row="2" column="1"><widget class="QComboBox" name="comboScope"><item><property name="text"><string>全图</string></property></item><item><property name="text"><string>当前视图</string></property></item></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="labelScale"><property name="text"><string>比例 1 :</string></property></widget></item>
      <item row="3" column="1"><widget class="QSpinBox" name="spinScale"><property name="minimum"><number>1</number></property><property name="maximum"><number>100000</number></property><property name="value"><number>100</number></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupStyle">
     <property name="title"><string>输出样式</string></property>
     <layout class="QVBoxLayout" name="vboxStyle">
      <item><widget class="QCheckBox" name="checkMonochrome"><property name="text"><string>黑白输出（全部线条为黑色）</string></property></widget></item>
      <item><widget class="QCheckBox" name="checkIncludeMeasure"><property name="text"><string>包含测量标注</string></property><property name="checked"><bool>true</bool></property></widget></item>
      <item><widget class="QCheckBox" name="checkLineweight"><property name="text"><string>按图层线宽输出</string></property><property name="checked"><bool>true</bool></property></widget></item>
     </layout>
    </widget>
   </item>
   <item><widget class="QLabel" name="labelNote"><property name="text"><string>PDF 由独立矢量绘制路径生成，不经过 DWG 写入。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="standardButtons"><enum>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</enum></property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
